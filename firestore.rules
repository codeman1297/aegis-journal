rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document isolated to the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Journal entries subcollection strictly isolated to the user
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Multi-turn reflections or conversational sub-documents
        match /turns/{turnId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Memory vault vectors subcollection strictly isolated to the user
      match /vectors/{vectorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Explicit deny-by-default tail
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
